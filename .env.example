# Contoh variabel lingkungan. File .env TIDAK dibaca otomatis oleh aplikasi
# dan TIDAK boleh di-commit ke GitHub (sudah ada di .gitignore).
#
# Cara memakai: salin ke .env, isi nilainya, lalu muat ke terminal sebelum menjalankan app:
#   set -a; source .env; set +a; python app.py
#
# Buat nilai acak milikmu sendiri dengan:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Set ke 1 hanya saat development lokal (menampilkan traceback di browser).
FLASK_DEBUG=0
